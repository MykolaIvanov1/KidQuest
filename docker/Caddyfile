{
	email {$CADDY_EMAIL}
	admin off
}

# Container-local liveness only; this port is not published by Compose.
http://127.0.0.1:8080 {
	bind 127.0.0.1
	respond /healthz 200
}

{$KIDQUEST_DOMAIN} {
	root * /srv
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:4000
	}
	@private path /storage/* /.env* /.git/*
	handle @private {
		respond 404
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		try_files {path} =404
		file_server
	}
	@shell path / /index.html /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"
	header /sw.js Service-Worker-Allowed /
	handle {
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "no-cache"
			file_server
		}
	}
}
