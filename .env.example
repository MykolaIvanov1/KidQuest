# Згенеруйте локальні секрети: pnpm setup:env. Не використовуйте ці маркери як паролі.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://kidquest:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/kidquest?schema=public
POSTGRES_USER=kidquest
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=kidquest
POSTGRES_PORT=5432
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_BYTES
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
VITE_API_URL=/api/v1
# Необов’язковий seed, або зареєструйте сім’ю через інтерфейс.
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=
SEED_CHILD_EMAIL=
SEED_CHILD_PASSWORD=
# Наступні етапи: push, AI, фото. На цьому етапі не використовуються.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
STORAGE_PATH=./storage
AI_API_KEY=
