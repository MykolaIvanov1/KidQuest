# Згенеруйте локальні секрети: pnpm setup:env. Не використовуйте ці маркери як паролі.
NODE_ENV=development
PORT=4000
# 1 only behind the single internal production proxy; keep 0 for direct local access.
TRUST_PROXY=0
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://kidquest:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/kidquest?schema=public
POSTGRES_USER=kidquest
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=kidquest
POSTGRES_PORT=5432
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_BYTES
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
VITE_API_URL=/api/v1
# Необов’язковий seed, або зареєструйте сім’ю через інтерфейс.
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=
SEED_CHILD_EMAIL=
SEED_CHILD_PASSWORD=
# Push необов’язковий. Без Firebase працює список сповіщень у застосунку.
# Сервер: service account того самого Firebase-проєкту. Приватний ключ лише в .env.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM одним рядком із символами \n; не додавайте ключ або JSON service account до Git.
FIREBASE_PRIVATE_KEY=
# Публічна конфігурація Web App та Web Push certificate (VAPID) із Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
STORAGE_PATH=./storage
# Квестик працює з локальними підказками без зовнішнього провайдера.
# Сам по собі ключ не вмикає зовнішні запити. Провайдера потрібно обрати й налаштувати окремо.
# Секрети AI зберігайте лише на backend, ніколи в VITE_*.
AI_API_KEY=
