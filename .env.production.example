# Copy with: pnpm setup:production --domain kidquest.your-domain.tld --email owner@your-domain.tld
# Secrets stay server-side. Never commit .env.production.
KIDQUEST_DOMAIN=kidquest.example.com
CADDY_EMAIL=owner@example.com
KIDQUEST_IMAGE_TAG=local
POSTGRES_USER=kidquest
POSTGRES_DB=kidquest
POSTGRES_PASSWORD=REPLACE_WITH_PRODUCTION_PASSWORD
DATABASE_URL=postgresql://kidquest:REPLACE_WITH_PRODUCTION_PASSWORD@db:5432/kidquest?schema=public&connection_limit=10
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
# Optional server-side Firebase credentials; set all three together or keep all blank.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public Firebase Web App values only. Changing these requires rebuilding the web image.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Квестик залишається локальним, без зовнішнього AI-провайдера.