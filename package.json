{
  "name": "kidquest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "predev": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm --parallel --filter @kidquest/backend --filter @kidquest/frontend dev",
    "build": "pnpm -r build",
    "pretypecheck": "pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck && tsc -p prisma/tsconfig.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "pnpm --filter \"./packages/**\" build",
    "test": "pnpm -r test",
    "setup:env": "node scripts/setup-env.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:test": "tsx prisma/verify-invariants.ts",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:install": "node scripts/e2e-install.mjs",
    "backup": "node -- scripts/backup.mjs",
    "setup:production": "node scripts/setup-production-env.mjs",
    "test:tooling": "node --test scripts/*.test.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.19.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  }
}
